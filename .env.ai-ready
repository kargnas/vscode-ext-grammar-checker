# AI Grammar Corrector - AI-Ready Development Environment
# For AI Agents (Codex, OpenCode, Cursor, etc.)
# This configuration requires no external services - ready to use immediately

# =============================================================================
# LLM API Configuration
# =============================================================================
# Note: AI Agents should set these via environment secrets, not in this file
# Required secrets: OPENAI_API_KEY (or OPENROUTER_API_KEY)

# API Endpoint (defaults to OpenAI in the extension)
# Leave commented to use default, or set for alternative providers
# API_URL=https://api.openai.com/v1/chat/completions

# Model (defaults to gpt-4o-mini in the extension)
# MODEL=gpt-4o-mini
