# AI Grammar Corrector - Development Environment
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Configuration
# =============================================================================

# OpenRouter API Key (recommended - supports multiple models)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Alternative: OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here

# API Endpoint URL
# - OpenRouter (default): https://openrouter.ai/api/v1/chat/completions
# - OpenAI: https://api.openai.com/v1/chat/completions
# - Azure: https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-02-15-preview
API_URL=https://openrouter.ai/api/v1/chat/completions

# Model to use for grammar checking
# Recommended models (fast & cheap):
# - google/gemini-2.5-flash-lite (default, very fast)
# - gpt-4o-mini (OpenAI, balanced)
# - anthropic/claude-3-haiku (fast)
MODEL=google/gemini-2.5-flash-lite
