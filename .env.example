# AI Grammar Corrector - Development Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Configuration (for development/testing)
# =============================================================================

# OpenAI API Key (or compatible provider)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# API Endpoint URL (default: OpenAI)
# For OpenRouter: https://openrouter.ai/api/v1/chat/completions
# For Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-02-15-preview
API_URL=https://api.openai.com/v1/chat/completions

# Model to use for grammar checking
# Recommended: gpt-4o-mini (fast, cheap), gpt-4o (better quality)
MODEL=gpt-4o-mini
